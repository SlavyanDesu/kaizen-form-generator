<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Kaizen Generator</title>
</head>
<body>
  <h1>Kaizen Generator</h1>

  <form action="/api/kaizen/generate" method="POST">
    <div>
      <label for="theme">Theme</label>
      <input
        type="text"
        id="theme"
        name="theme"
        required
      >
    </div>

    <br>

    <button type="submit">Generate Excel</button>
  </form>
</body>
</html>